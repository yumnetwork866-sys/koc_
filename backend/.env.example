DATABASE_URL=postgresql://user:password@127.0.0.1:5432/report
PORT=8000
FRONTEND_URL=http://localhost:3005
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
SESSION_SECRET=replace_with_a_unique_secret_of_at_least_32_characters
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_TOKEN_ENCRYPTION_KEY=replace_with_a_unique_secret_of_at_least_32_characters
TIKTOK_REDIRECT_URI=https://your-app.example.com/api/channels/oauth/tiktok/callback
TIKTOK_OAUTH_AUTHORIZE_BASE_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
TIKTOK_SYNC_CONCURRENCY=3
TIKTOK_SYNC_SCHEDULE=0 2 * * *
TIKTOK_SYNC_TIMEZONE=Asia/Ho_Chi_Minh

# TikTok Shop Partner API (Affiliate Creator / Booking)
# Use the App Key and App Secret from TikTok Shop Partner Center, not Login Kit credentials above.
TIKTOK_PARTNER_APP_KEY=your_tiktok_shop_partner_app_key
TIKTOK_PARTNER_APP_SECRET=your_tiktok_shop_partner_app_secret
TIKTOK_PARTNER_SERVICE_ID=your_tiktok_shop_service_id
TIKTOK_PARTNER_REDIRECT_URI=https://your-api.example.com/api/bookings/tiktok-partner/callback
TIKTOK_PARTNER_TOKEN_ENCRYPTION_KEY=replace_with_a_unique_secret_of_at_least_32_characters
TIKTOK_PARTNER_SCOPES=creator.affiliate.info,creator.data.live.read.public,creator.affiliate.link.write,creator.showcase.write,creator.affiliate_collaboration.read,creator.showcase.read,seller.authorization.info,data.shop_analytics.public.read,seller.affiliate_collaboration.read
TIKTOK_PARTNER_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_PARTNER_AUTHORIZE_URL=https://shop.tiktok.com/alliance/creator/auth
TIKTOK_PARTNER_TOKEN_BASE_URL=https://auth.tiktok-shops.com/api/v2/token
TIKTOK_PARTNER_PAGE_SIZE=20.
TIKTOK_SHOP_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_SHOP_REQUEST_TIMEOUT_MS=15000
TIKTOK_CREATOR_PERFORMANCE_SCHEDULE=30 3 * * *
TIKTOK_CREATOR_PERFORMANCE_TIMEZONE=Asia/Kuala_Lumpur
TIKTOK_CREATOR_PROFILE_CONCURRENCY=5
TIKTOK_SELLER_AFFILIATE_CACHE_TTL_MS=120000

# Facebook Page chatbot
BASE_URL=https://your-public-api.example.com
VERIFY_TOKEN=replace_with_a_webhook_verify_token
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
PAGE_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it
CHATBOT_MODELS=gemini:gemma-3-27b-it,ollama:llama3.1:8b,ollama:qwen2.5:7b-instruct
OLLAMA_HOST=http://127.0.0.1:11434
FB_CHATBOT_DEBUG=1
